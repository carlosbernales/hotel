        CASE 
            WHEN eb.booking_source = 'Regular Booking' THEN us.name
            WHEN eb.booking_source = 'Customer Booking' THEN u.name
            ELSE 'N/A'
        END as display_name
        FROM event_bookings eb
        LEFT JOIN userss us ON eb.user_id = us.id
        LEFT JOIN users u ON eb.user_id = u.id
        WHERE eb.booking_status = 'pending'
        ORDER BY eb.created_at DESC
