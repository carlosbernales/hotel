[10-Apr-2025 19:27:06 Asia/Manila] Event bookings query: SELECT eb.*, 
               COALESCE(ep.name, eb.package_name) as display_package_name,
               ep.menu_items as package_menu,
               CASE 
                   WHEN eb.user_id IS NOT NULL THEN CONCAT(u.firstname, ' ', u.lastname)
                   ELSE eb.customer_name 
               END as customer_name
        FROM event_bookings eb 
        LEFT JOIN event_packages ep ON eb.package_name = ep.name 
        LEFT JOIN users u ON eb.user_id = u.id
        ORDER BY eb.created_at DESC
