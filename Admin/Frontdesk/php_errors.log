[10-Apr-2025 05:00:45 Asia/Manila] Event bookings query: SELECT eb.*, 
        COALESCE(
            CASE 
                WHEN eb.booking_source = 'Regular Booking' THEN CONCAT(u.firstname, ' ', u.lastname)
                ELSE CONCAT(us.first_name, ' ', us.last_name)
            END,
            eb.customer_name,
            'N/A'
        ) as customer_name
        FROM event_bookings eb
        LEFT JOIN users u ON eb.user_id = u.id AND eb.booking_source = 'Regular Booking'
        LEFT JOIN userss us ON eb.user_id = us.id AND eb.booking_source != 'Regular Booking'
        ORDER BY eb.created_at DESC
