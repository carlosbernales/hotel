[13-Apr-2025 02:11:26 Asia/Manila] SQL Query: SELECT 
    b.booking_id,
    CONCAT(b.first_name, ' ', b.last_name) as guest_name,
    b.first_name,
    b.last_name,
    b.email,
    b.contact,
    b.check_in,
    b.check_out,
    b.number_of_guests,
    rt.room_type,
    rt.price as room_price,
    b.room_type_id,
    b.total_amount,
    b.payment_method,
    DATEDIFF(b.check_out, b.check_in) as nights,
    b.status,
    b.payment_option,
    CASE 
        WHEN b.payment_option = 'Full' THEN b.total_amount
        WHEN b.payment_option = 'Downpayment' THEN 1500
        ELSE 0
    END as amount_paid,
    CASE 
        WHEN b.payment_option = 'Full' THEN 0
        WHEN b.payment_option = 'Downpayment' THEN (b.total_amount - 1500)
        ELSE b.total_amount
    END as remaining_balance,
    b.discount_type,
    b.extra_charges
FROM bookings b
LEFT JOIN room_types rt ON b.room_type_id = rt.room_type_id
WHERE b.status IN ('Checked in', 'Extended')
ORDER BY b.check_in DESC
